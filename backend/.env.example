# ---------- Serveur ----------
PORT=4000

# ---------- Securite ----------
# Cle utilisee pour signer les tokens JWT (a changer en production)
JWT_SECRET=changez-cette-cle-en-production
JWT_EXPIRES_IN=7d

# Origines autorisees par CORS, separees par des virgules.
# Laisser vide autorise toutes les origines (pratique en developpement).
CORS_ORIGIN=

# ---------- Base de donnees ----------
# Aucun reglage n'est necessaire pour demarrer : SQLite (sql.js) est utilise
# et le fichier est cree dans ./data/arena-hotels.sqlite

# Option 1 - PostgreSQL (Neon, Supabase, Vercel Postgres, Railway...)
# DATABASE_URL=postgresql://user:motdepasse@hote:5432/arena_hotels
# DB_TYPE=postgres
# DB_SSL=true

# Option 2 - MySQL / MariaDB
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=secret
# DB_DATABASE=arena_hotels

# Option 3 - SQLite en memoire uniquement (plateformes serverless)
# SQLJS_PERSIST=false
# SQLJS_LOCATION=/tmp/arena-hotels.sqlite

# DB_SYNCHRONIZE=false   # a desactiver en production reelle
# DB_LOGGING=true
