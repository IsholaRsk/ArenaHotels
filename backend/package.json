{
  "name": "@arena-hotels/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST NestJS - ArenaHotels",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
